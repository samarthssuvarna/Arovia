{
  "info": {
    "name": "Arovia API tests",
    "description": "Run the whole collection with the Collection Runner. Start the backend first (uvicorn on port 8000) with the seeded demo data. Run order matters: each request saves ids for the next one.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000"
    }
  ],
  "item": [
    {
      "name": "1. Sign in and token rules",
      "description": "Checks login, the token type separation and that bad passwords are refused. The login limiter allows 5 failures per 15 minutes, so this folder only uses one wrong attempt.",
      "item": [
        {
          "name": "Doctor login (Dr. Rohan Mehta)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Login works (200)\", () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test(\"A token is returned\", () => pm.expect(j.access_token).to.be.a(\"string\"));",
                  "pm.collectionVariables.set(\"docToken\", j.access_token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"rohan.mehta@demo.test\",\n  \"password\": \"Pass@123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Admin login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Login works (200)\", () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test(\"A token is returned\", () => pm.expect(j.access_token).to.be.a(\"string\"));",
                  "pm.collectionVariables.set(\"adminToken\", j.access_token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@demo.test\",\n  \"password\": \"Pass@123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Patient login (MRN-0001)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Login works (200)\", () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test(\"A token is returned\", () => pm.expect(j.access_token).to.be.a(\"string\"));",
                  "pm.collectionVariables.set(\"patToken\", j.access_token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/patient-login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "patient-login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"mrn-0001@demo.test\",\n  \"password\": \"Pass@123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Wrong password is refused",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Wrong password gives 401\", () => pm.response.to.have.status(401));",
                  "pm.test(\"Message does not reveal whether the email exists\", () => pm.expect(pm.response.json().detail).to.eql(\"Invalid email or password\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"rohan.mehta@demo.test\",\n  \"password\": \"wrong-password\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Patient token cannot call a doctor endpoint",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Refused (401 or 403)\", () => pm.expect(pm.response.code).to.be.oneOf([401,403]));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{patToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/dashboard",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "dashboard"
              ]
            }
          }
        },
        {
          "name": "Doctor token cannot call a patient endpoint",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Refused (401 or 403)\", () => pm.expect(pm.response.code).to.be.oneOf([401,403]));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{docToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/portal/consents",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "portal",
                "consents"
              ]
            }
          }
        },
        {
          "name": "No token at all is refused",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Refused (401 or 403)\", () => pm.expect(pm.response.code).to.be.oneOf([401,403]));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/dashboard",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "dashboard"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "2. Consent decides who can read a record",
      "description": "The core promise of the project: a doctor can read a record only while the patient allows it, and every attempt is logged.",
      "item": [
        {
          "name": "Patient lists doctors",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200\", () => pm.response.to.have.status(200));",
                  "const rohan = pm.response.json().find(d => d.name === \"Dr. Rohan Mehta\");",
                  "pm.test(\"Dr. Rohan Mehta is in the list\", () => pm.expect(rohan).to.exist);",
                  "pm.collectionVariables.set(\"rohanId\", rohan.provider_id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{patToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/portal/doctors",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "portal",
                "doctors"
              ]
            }
          }
        },
        {
          "name": "Patient gives Dr. Mehta access",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = JSON.parse(pm.request.body.raw);",
                  "body.provider_id = Number(pm.collectionVariables.get(\"rohanId\"));",
                  "pm.request.body.raw = JSON.stringify(body);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Granted (201) or already granted (409)\", () => pm.expect(pm.response.code).to.be.oneOf([201,409]));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{patToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/portal/consents",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "portal",
                "consents"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"provider_id\": \"{{rohanId}}\",\n  \"days\": 90\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Patient sees the active consent",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200\", () => pm.response.to.have.status(200));",
                  "const active = pm.response.json().find(c => c.provider === \"Dr. Rohan Mehta\" && c.effective_status === \"active\");",
                  "pm.test(\"An active consent for Dr. Mehta exists\", () => pm.expect(active).to.exist);",
                  "pm.collectionVariables.set(\"consentId\", active.consent_id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{patToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/portal/consents",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "portal",
                "consents"
              ]
            }
          }
        },
        {
          "name": "Doctor finds the patient",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200\", () => pm.response.to.have.status(200));",
                  "const p = pm.response.json()[0];",
                  "pm.test(\"Patient found\", () => pm.expect(p).to.exist);",
                  "pm.test(\"Search shows that consent is valid\", () => pm.expect(p.has_consent).to.eql(true));",
                  "pm.test(\"Search returns identity only (no clinical data)\", () => pm.expect(p).to.not.have.property(\"encounters\"));",
                  "pm.collectionVariables.set(\"patientId\", p.patient_id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{docToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/patients/search?q=MRN-0001",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "patients",
                "search"
              ],
              "query": [
                {
                  "key": "q",
                  "value": "MRN-0001"
                }
              ]
            }
          }
        },
        {
          "name": "Doctor opens the history (allowed)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 with valid consent\", () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test(\"History has visits from all providers\", () => pm.expect(j.encounters).to.be.an(\"array\").that.is.not.empty);",
                  "pm.test(\"Allergies are included\", () => pm.expect(j.allergies).to.be.an(\"array\"));",
                  "pm.test(\"Consent expiry is returned\", () => pm.expect(j.consent).to.have.property(\"days_left\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{docToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/patients/{{patientId}}/history?reason=Postman test: consult",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "patients",
                "{{patientId}}",
                "history"
              ],
              "query": [
                {
                  "key": "reason",
                  "value": "Postman test: consult"
                }
              ]
            }
          }
        },
        {
          "name": "Patient removes access",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Revoked (200)\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{patToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/portal/consents/{{consentId}}/revoke",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "portal",
                "consents",
                "{{consentId}}",
                "revoke"
              ]
            }
          }
        },
        {
          "name": "Doctor opens the history again (refused)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Refused with 403 after the patient removed access\", () => pm.response.to.have.status(403));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{docToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/patients/{{patientId}}/history?reason=Postman test: after removal",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "patients",
                "{{patientId}}",
                "history"
              ],
              "query": [
                {
                  "key": "reason",
                  "value": "Postman test: after removal"
                }
              ]
            }
          }
        },
        {
          "name": "Patient sees the refused attempt in their log",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200\", () => pm.response.to.have.status(200));",
                  "const refused = pm.response.json().filter(r => r.granted === false);",
                  "pm.test(\"The refused attempt was recorded\", () => pm.expect(refused.length).to.be.above(0));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{patToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/portal/access-log",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "portal",
                "access-log"
              ]
            }
          }
        },
        {
          "name": "Patient gives access again (restore)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = JSON.parse(pm.request.body.raw);",
                  "body.provider_id = Number(pm.collectionVariables.get(\"rohanId\"));",
                  "pm.request.body.raw = JSON.stringify(body);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Access restored (201)\", () => pm.response.to.have.status(201));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{patToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/portal/consents",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "portal",
                "consents"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"provider_id\": \"{{rohanId}}\",\n  \"days\": 90\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "3. Encounters, allergies and referrals",
      "description": "",
      "item": [
        {
          "name": "Prescription that conflicts with an allergy is blocked",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Blocked with 409\", () => pm.response.to.have.status(409));",
                  "const d = pm.response.json().detail;",
                  "pm.test(\"Conflict is explained\", () => pm.expect(d.conflicts).to.be.an(\"array\").that.is.not.empty);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{docToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/patients/{{patientId}}/encounters",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "patients",
                "{{patientId}}",
                "encounters"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"notes\": \"Postman test visit\",\n  \"diagnoses\": [\n    {\n      \"condition\": \"Test condition\"\n    }\n  ],\n  \"prescriptions\": [\n    {\n      \"medicine\": \"Sulfamethoxazole\",\n      \"dosage\": \"1 tablet\"\n    }\n  ],\n  \"override_allergy_warning\": false\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Doctor lists endocrinologists",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200\", () => pm.response.to.have.status(200));",
                  "const list = pm.response.json();",
                  "pm.test(\"At least one endocrinologist\", () => pm.expect(list).to.not.be.empty);",
                  "pm.collectionVariables.set(\"otherDocId\", list[0].provider_id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{docToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/providers?specialty=Endocrinology",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "providers"
              ],
              "query": [
                {
                  "key": "specialty",
                  "value": "Endocrinology"
                }
              ]
            }
          }
        },
        {
          "name": "Doctor sends a referral",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = JSON.parse(pm.request.body.raw);",
                  "body.patient_id = Number(pm.collectionVariables.get(\"patientId\"));",
                  "body.to_provider = Number(pm.collectionVariables.get(\"otherDocId\"));",
                  "pm.request.body.raw = JSON.stringify(body);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Created (201)\", () => pm.response.to.have.status(201));",
                  "const j = pm.response.json();",
                  "pm.test(\"Starts as pending\", () => pm.expect(j.status).to.eql(\"pending\"));",
                  "pm.collectionVariables.set(\"referralId\", j.referral_id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{docToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/referrals",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "referrals"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"patient_id\": \"{{patientId}}\",\n  \"to_provider\": \"{{otherDocId}}\",\n  \"reason\": \"Postman test referral\",\n  \"urgency\": \"routine\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Sender cancels the referral",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Cancelled (200)\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Status is cancelled\", () => pm.expect(pm.response.json().status).to.eql(\"cancelled\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{docToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/referrals/{{referralId}}/status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "referrals",
                "{{referralId}}",
                "status"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"cancelled\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "A closed referral cannot be reopened",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Invalid state change is refused\", () => pm.expect(pm.response.code).to.be.oneOf([400,403,409]));"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{docToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/referrals/{{referralId}}/status",
              "host": [
                "{{baseUrl}}"
